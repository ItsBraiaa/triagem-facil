# Copie este arquivo para .env e substitua os valores COLE_... pelos seus.
# O .env é local: não o envie ao repositório nem o mostre na apresentação.
# Reinicie o programa depois de alterar este arquivo.

# Provedor de IA usado nesta execução: gemini (padrão) ou openrouter.
AI_PROVIDER=gemini

# Gemini: chave do Google AI Studio e identificador de um modelo de texto disponível no seu projeto.
GEMINI_API_KEY=COLE_SUA_CHAVE_GEMINI_AQUI
GEMINI_MODEL=COLE_O_IDENTIFICADOR_DO_MODELO_GEMINI_AQUI

# OpenRouter: preencha somente se usar AI_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Telegram: token do @BotFather, necessário apenas para o bot.py. Deixe vazio para usar só a tela.
TELEGRAM_BOT_TOKEN=COLE_O_TOKEN_DO_BOT_AQUI

# Opcional: outro caminho para o banco de dados SQLite dos chamados. Sem esta variável
# (ou vazia), o arquivo triagem.db fica na pasta do aplicativo. No Docker, o compose.yaml
# já define DB_PATH=/app/data/triagem.db.
# DB_PATH=

# Opcional: caminho do historico.csv da versão anterior, usado apenas pela importação
# (área de gestão > Importar histórico CSV). Sem esta variável, o arquivo procurado é
# historico.csv na pasta do aplicativo. No Docker, o compose.yaml já define
# CSV_PATH=/app/data/historico.csv.
# CSV_PATH=
